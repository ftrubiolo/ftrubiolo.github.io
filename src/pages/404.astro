---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, withBase } from '../config/site';
import { UI } from '../i18n/translations';

const t = UI.es.notFound;
---

<BaseLayout lang="es" title={`404 — ${SITE.author}`} description={t.body}>
  <section class="w-full py-28">
    <div class="content-column text-center">
      <div class="font-mono text-xs text-[var(--accent-ink)] dark:text-[var(--accent-bright)]">
        ERR // 404
      </div>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight text-[var(--text)]">
        {t.title}
      </h1>
      <p class="mt-3 text-base text-[var(--text-secondary)]">
        {t.body}
      </p>
      <div class="mt-7">
        <a href={withBase('/')} class="btn-sharp">
          {t.cta}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
