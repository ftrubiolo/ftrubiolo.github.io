---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, formatDate, withBase } from '../../config/site';

const posts = SITE.features.writing
  ? (await getCollection('posts'))
      .filter((p) => !p.data.draft)
      .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  : [];

const allTags = Array.from(new Set(posts.flatMap((p) => p.data.tags))).sort();
---

<BaseLayout
  title={`Writing — ${SITE.author}`}
  description="Essays, technical notes, and architecture write-ups."
>
  <section class="w-full pt-16 pb-10 sm:pt-20">
    <div class="content-column text-center">
      <h1 class="text-3xl font-semibold tracking-tight text-[var(--text)] sm:text-4xl">
        Writing
      </h1>
      <p class="mt-3 text-base leading-relaxed text-[var(--text-secondary)]">
        Long-form notes on software engineering, design clarity, and building maintainable tools.
      </p>

      {
        allTags.length > 0 && (
          <div class="mt-7 flex flex-wrap items-center justify-center gap-2" role="group" aria-label="Filter articles by tag">
            <button
              type="button"
              data-filter-tag="all"
              class="rounded-[2px] border border-[var(--accent)] bg-[var(--accent-soft)] px-2.5 py-1 font-mono text-[11px] text-[var(--accent-ink)] dark:text-[var(--accent-bright)] cursor-pointer transition-colors"
            >
              All ({posts.length})
            </button>
            {allTags.map((tag) => (
              <button
                type="button"
                data-filter-tag={tag}
                class="rounded-[2px] border border-[var(--border)] bg-[var(--surface)] px-2.5 py-1 font-mono text-[11px] text-[var(--text-secondary)] hover:border-[var(--border-strong)] hover:text-[var(--text)] cursor-pointer transition-colors"
              >
                #{tag}
              </button>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <section class="w-full pb-16">
    {
      posts.length > 0 ? (
        <div class="content-column divide-y divide-[var(--border)] border-y border-[var(--border)]">
          {posts.map((post) => (
            <article
              data-post-item
              data-tags={post.data.tags.join(',')}
              class="py-7"
            >
              <a href={withBase(`/writing/${post.id}`)} class="group block">
                <div class="flex flex-wrap items-center gap-2.5 font-mono text-[11px] text-[var(--text-muted)]">
                  <span class="text-[var(--accent-ink)] dark:text-[var(--accent-bright)]">
                    {post.data.category}
                  </span>
                  <span>·</span>
                  <time datetime={post.data.publishedAt.toISOString()}>
                    {formatDate(post.data.publishedAt)}
                  </time>
                  <span>·</span>
                  <span>{post.data.readingTime}</span>
                </div>

                <h2 class="mt-2 text-xl font-semibold tracking-tight text-[var(--text)] transition-colors group-hover:text-[var(--accent)] sm:text-[22px]">
                  {post.data.title}
                </h2>

                <p class="mt-2 text-[15px] leading-relaxed text-[var(--text-secondary)]">
                  {post.data.description}
                </p>

                <div class="mt-3 flex flex-wrap items-center justify-between gap-2">
                  <div class="flex flex-wrap gap-1.5">
                    {post.data.tags.map((tag) => (
                      <span class="rounded-[2px] border border-[var(--border)] bg-[var(--surface)] px-2 py-0.5 font-mono text-[11px] text-[var(--text-muted)]">
                        #{tag}
                      </span>
                    ))}
                  </div>
                  <span class="font-mono text-xs text-[var(--text-muted)] group-hover:text-[var(--accent)] transition-colors">
                    Read article →
                  </span>
                </div>
              </a>
            </article>
          ))}
        </div>
      ) : (
        <div class="content-column border-y border-[var(--border)] py-12 text-center text-sm text-[var(--text-muted)]">
          No articles published yet.
        </div>
      )
    }
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const buttons = Array.from(document.querySelectorAll('[data-filter-tag]'));
    const items = Array.from(document.querySelectorAll('[data-post-item]'));
    if (!buttons.length || !items.length) return;

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selected = btn.getAttribute('data-filter-tag') || 'all';

        buttons.forEach((b) => {
          const active = b === btn;
          b.classList.toggle('border-[var(--accent)]', active);
          b.classList.toggle('bg-[var(--accent-soft)]', active);
          b.classList.toggle('text-[var(--accent-ink)]', active);
          b.classList.toggle('dark:text-[var(--accent-bright)]', active);

          b.classList.toggle('border-[var(--border)]', !active);
          b.classList.toggle('bg-[var(--surface)]', !active);
          b.classList.toggle('text-[var(--text-secondary)]', !active);
        });

        items.forEach((item) => {
          const tags = (item.getAttribute('data-tags') || '').split(',').filter(Boolean);
          const visible = selected === 'all' || tags.includes(selected);
          item.classList.toggle('hidden', !visible);
        });
      });
    });
  })();
</script>
