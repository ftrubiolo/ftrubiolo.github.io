---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CoverArt from '../../components/CoverArt.astro';
import { SITE, formatDate, withBase } from '../../config/site';

export async function getStaticPaths() {
  if (!SITE.features.writing) return [];
  const posts = (await getCollection('posts')).filter((p) => !p.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const allPosts = (await getCollection('posts'))
  .filter((p) => !p.data.draft && p.id !== post.id)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 2);

const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout
  title={`${post.data.title} — ${SITE.author}`}
  description={post.data.description}
  ogType="article"
>
  <div class="relative w-full pt-10 pb-20 sm:pt-14">
    <!-- note.com-inspired sticky left margin rail aligned with navbar (left-8) -->
    <aside class="hidden xl:block xl:fixed xl:left-8 xl:top-20 xl:z-20 xl:w-44">
      <div class="border-b border-[var(--border)] pb-4">
        <div class="flex items-center gap-2.5">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[var(--border-strong)] bg-[var(--surface-solid)] font-mono text-xs font-semibold text-[var(--text)]">
            {SITE.avatarInitials}
          </div>
          <div class="min-w-0">
            <div class="truncate text-xs font-semibold text-[var(--text)]">{SITE.author}</div>
            <div class="truncate font-mono text-[10px] text-[var(--text-muted)]">{SITE.handle}</div>
          </div>
        </div>
        <a
          href={SITE.social.github}
          target="_blank"
          rel="noreferrer"
          class="mt-3 inline-flex w-full items-center justify-center rounded-[2px] border border-[var(--border)] bg-[var(--surface)] px-2.5 py-1 text-[11px] font-medium text-[var(--text-secondary)] transition-colors hover:border-[var(--accent)] hover:text-[var(--text)]"
        >
          Follow on GitHub
        </a>
      </div>

      {
        tocHeadings.length > 0 && (
          <nav aria-label="Table of contents" class="mt-4">
            <div class="font-mono text-[10px] uppercase tracking-wider text-[var(--text-muted)]">
              Contents
            </div>
            <ul class="mt-2.5 space-y-2 border-l border-[var(--border)] pl-3">
              {tocHeadings.map((heading) => (
                <li class:list={[heading.depth === 3 && 'pl-2.5']}>
                  <a
                    href={`#${heading.slug}`}
                    class="block text-xs leading-snug text-[var(--text-muted)] transition-colors hover:text-[var(--accent)]"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </aside>

    <article class="w-full">
      <div class="reading-column mb-6">
        <a
          href={withBase('/writing')}
          class="inline-flex items-center gap-1.5 font-mono text-xs text-[var(--text-muted)] transition-colors hover:text-[var(--text)]"
        >
          ← Back to writing
        </a>
      </div>

      <!-- Wide breakout cover graphic (clamp(0px, 95vw, 900px)) -->
      <div class="wide-column">
        <CoverArt
          title={post.data.title}
          category={post.data.category}
          tone={post.data.coverTone}
        />
      </div>

      <!-- 640px centered reading column -->
      <header class="reading-column mt-8 border-b border-[var(--border)] pb-7">
        <h1 class="text-[28px] font-bold leading-[1.24] tracking-tight text-[var(--text)] sm:text-[34px]">
          {post.data.title}
        </h1>

        <p class="mt-3 text-base leading-relaxed text-[var(--text-secondary)]">
          {post.data.description}
        </p>

        <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <div class="flex h-9 w-9 items-center justify-center rounded-full border border-[var(--border-strong)] bg-[var(--surface-solid)] font-mono text-xs font-semibold text-[var(--text)]">
              {SITE.avatarInitials}
            </div>
            <div>
              <div class="text-sm font-medium text-[var(--text)]">{SITE.author}</div>
              <div class="flex items-center gap-2 font-mono text-[11px] text-[var(--text-muted)]">
                <time datetime={post.data.publishedAt.toISOString()}>
                  {formatDate(post.data.publishedAt)}
                </time>
                <span>·</span>
                <span>{post.data.readingTime}</span>
              </div>
            </div>
          </div>

          <div class="flex flex-wrap gap-1.5">
            {
              post.data.tags.map((tag) => (
                <span class="rounded-[2px] border border-[var(--border)] bg-[var(--surface)] px-2 py-0.5 font-mono text-[11px] text-[var(--text-muted)]">
                  #{tag}
                </span>
              ))
            }
          </div>
        </div>
      </header>

      <!-- Article Body (640px note.com prose measure) -->
      <div class="reading-column reading-prose mt-9">
        <Content />
      </div>

      <!-- note.com-inspired bottom author card -->
      <section class="reading-column mt-14 border-t border-[var(--border)] pt-8">
        <div class="surface-card rounded-[2px] p-5 sm:p-6">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-start gap-3.5">
              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-[var(--border-strong)] bg-[var(--surface-solid)] font-mono text-sm font-semibold text-[var(--text)]">
                {SITE.avatarInitials}
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <span class="text-sm font-semibold text-[var(--text)]">{SITE.author}</span>
                  <span class="font-mono text-[11px] text-[var(--text-muted)]">{SITE.handle}</span>
                </div>
                <p class="mt-1 text-xs leading-relaxed text-[var(--text-secondary)]">
                  {SITE.bio}
                </p>
              </div>
            </div>

            <a
              href={`mailto:${SITE.email}`}
              class="btn-sharp shrink-0 text-xs"
            >
              Get in touch
            </a>
          </div>
        </div>
      </section>

      <!-- Related / More reading -->
      {
        allPosts.length > 0 && (
          <section class="reading-column mt-12">
            <div class="font-mono text-[11px] uppercase tracking-wider text-[var(--text-muted)]">
              More Writing
            </div>
            <div class="mt-4 grid gap-4 sm:grid-cols-2">
              {allPosts.map((other) => (
                <a
                  href={withBase(`/writing/${other.id}`)}
                  class="surface-card group flex flex-col justify-between rounded-[2px] p-4 transition-colors hover:border-[var(--border-strong)]"
                >
                  <div>
                    <div class="font-mono text-[11px] text-[var(--accent-ink)] dark:text-[var(--accent-bright)]">
                      {other.data.category} · {other.data.readingTime}
                    </div>
                    <h3 class="mt-1.5 text-sm font-semibold leading-snug text-[var(--text)] group-hover:text-[var(--accent)] transition-colors">
                      {other.data.title}
                    </h3>
                  </div>
                  <div class="mt-3 font-mono text-[11px] text-[var(--text-muted)]">
                    {formatDate(other.data.publishedAt)} →
                  </div>
                </a>
              ))}
            </div>
          </section>
        )
      }
    </article>
  </div>
</BaseLayout>
