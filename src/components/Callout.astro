---
interface Props {
  label?: string;
}

const { label = 'Note' } = Astro.props;
---

<aside class="my-7 rounded-[2px] border border-[var(--border)] border-l-[3px] border-l-[var(--accent)] bg-[var(--accent-soft)] px-4 py-3.5 text-[15px] leading-relaxed text-[var(--text)]">
  <div class="mb-1 font-mono text-[11px] font-medium uppercase tracking-wider text-[var(--accent-ink)] dark:text-[var(--accent-bright)]">
    {label}
  </div>
  <div class="text-[var(--text-secondary)] [&>p]:m-0">
    <slot />
  </div>
</aside>
