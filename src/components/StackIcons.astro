---
import type { StackItem } from '../config/site';

interface Props {
  items: StackItem[];
  compact?: boolean;
}

const { items, compact = false } = Astro.props;
---

<div
  class:list={[
    'flex flex-wrap items-center justify-center',
    compact ? 'mt-4 gap-1.5 sm:gap-2' : 'mt-9 gap-2.5 sm:gap-3.5',
  ]}
  aria-label="Technical stack"
>
  {
    items.map((item) => (
      <div class="group relative flex items-center justify-center">
        <button
          type="button"
          aria-label={item.label}
          class:list={[
            'flex items-center justify-center rounded-[2px] border border-transparent text-[var(--text-muted)] transition-all duration-150 hover:-translate-y-0.5 hover:border-[var(--border)] hover:bg-[var(--surface)] hover:text-[var(--accent)] focus-visible:-translate-y-0.5 focus-visible:border-[var(--accent)] focus-visible:text-[var(--accent)] focus-visible:outline-none cursor-default',
            compact ? 'h-9 w-9' : 'h-10 w-10',
          ]}
        >
          {item.id === 'typescript' && (
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M3 3h18v18H3V3zm10.71 14.86c.5.98 1.51 1.73 3.09 1.73 1.6 0 2.8-.83 2.8-2.36 0-1.41-.81-2.04-2.25-2.66l-.42-.18c-.73-.31-1.04-.52-1.04-1.02 0-.41.31-.73.81-.73.48 0 .8.21 1.09.73l1.31-.87c-.55-.96-1.33-1.33-2.4-1.33-1.51 0-2.48.96-2.48 2.23 0 1.38.81 2.03 2.03 2.55l.42.18c.78.34 1.24.55 1.24 1.13 0 .48-.45.83-1.15.83-.83 0-1.31-.43-1.67-1.03l-1.38.8zM13 11.25H8v1.5h1.63V19h1.75v-6.25H13v-1.5z" />
            </svg>
          )}

          {item.id === 'react' && (
            <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <circle cx="12" cy="12" r="2" fill="currentColor" stroke="none" />
              <ellipse cx="12" cy="12" rx="10" ry="4.2" />
              <ellipse cx="12" cy="12" rx="10" ry="4.2" transform="rotate(60 12 12)" />
              <ellipse cx="12" cy="12" rx="10" ry="4.2" transform="rotate(120 12 12)" />
            </svg>
          )}

          {item.id === 'threejs' && (
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true">
              <polygon points="4,4 20,8 8,20" />
              <polygon points="4,4 12,6 6,12" />
              <polygon points="12,6 20,8 14,14" />
              <polygon points="6,12 14,14 8,20" />
              <polygon points="12,6 14,14 6,12" />
            </svg>
          )}

          {item.id === 'electron' && (
            <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.45" aria-hidden="true">
              <circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none" />
              <ellipse cx="12" cy="12" rx="9.5" ry="3.8" transform="rotate(30 12 12)" />
              <ellipse cx="12" cy="12" rx="9.5" ry="3.8" transform="rotate(-30 12 12)" />
              <circle cx="5.2" cy="6.5" r="1.2" fill="currentColor" stroke="none" />
              <circle cx="18.8" cy="17.5" r="1.2" fill="currentColor" stroke="none" />
            </svg>
          )}

          {item.id === 'astro' && (
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M8.3 20.4c-.9-.9-1.2-2.7-.8-4.1.9 1.1 2.2 1.5 3.6 1.7 2.1.3 4.2-.2 6.1-1.3.2.5.3 1.1.3 1.7 0 1.6-.9 2.9-2.2 3.6.5-1 .4-2-.4-2.7-.8-.7-2.2-.8-3.3-.2-.8.4-1.3 1.2-1.2 2.1-.9-.2-1.6-.5-2.1-.8zM5.6 14.9L9.8 3.6c.2-.5.6-.8 1.2-.8h2c.6 0 1 .3 1.2.8l4.2 11.3c-1.4-.8-2.9-1.3-4.5-1.6l-1.8-5.4c-.1-.2-.4-.2-.5 0l-1.8 5.4c-1.5.3-3 .8-4.2 1.6z" />
            </svg>
          )}

          {item.id === 'tailwind' && (
            <svg width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 6c-2.67 0-4.33 1.33-5 4 1-1.33 2.17-1.83 3.5-1.5.76.19 1.31.74 1.91 1.35C13.4 10.84 14.53 12 17 12c2.67 0 4.33-1.33 5-4-1 1.33-2.17 1.83-3.5 1.5-.76-.19-1.31-.74-1.91-1.35C15.6 7.16 14.47 6 12 6zm-5 6c-2.67 0-4.33 1.33-5 4 1-1.33 2.17-1.83 3.5-1.5.76.19 1.31.74 1.91 1.35C8.4 16.84 9.53 18 12 18c2.67 0 4.33-1.33 5-4-1 1.33-2.17 1.83-3.5 1.5-.76-.19-1.31-.74-1.91-1.35C10.6 13.16 9.47 12 7 12z" />
            </svg>
          )}

          {item.id === 'nodejs' && (
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 2.5L20.5 7.4V16.6L12 21.5L3.5 16.6V7.4L12 2.5Z" />
              <path d="M9.5 14.6c.4.6 1.2.9 2.3.9 1.6 0 2.7-.7 2.7-1.9 0-1.1-.8-1.6-2.4-1.9l-.6-.1c-1-.2-1.5-.5-1.5-1.1 0-.7.7-1.1 1.7-1.1.9 0 1.5.3 1.9.8" stroke-linecap="round" />
            </svg>
          )}

          {item.id === 'postgresql' && (
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <ellipse cx="12" cy="6.5" rx="7" ry="3" />
              <path d="M5 6.5v5c0 1.66 3.13 3 7 3s7-1.34 7-3v-5" />
              <path d="M5 11.5v5c0 1.66 3.13 3 7 3s7-1.34 7-3v-5" />
            </svg>
          )}

          {item.id === 'supabase' && (
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M13.35 20.6c-.54.68-1.64.31-1.66-.56l-.2-7.82h8.03c1.45 0 2.26 1.68 1.35 2.82l-7.52 5.56zM10.65 3.4c.54-.68 1.64-.31 1.66.56l.15 7.82H4.48c-1.45 0-2.26-1.68-1.35-2.82L10.65 3.4z" />
            </svg>
          )}

          {item.id === 'docker' && (
            <svg width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M13 6h2.2v2.2H13V6zm-3 0h2.2v2.2H10V6zM7 9h2.2v2.2H7V9zm3 0h2.2v2.2H10V9zm3 0h2.2v2.2H13V9zm-6-3h2.2v2.2H7V6zm-3 3h2.2v2.2H4V9zm15.9 2.3c-.5-.3-1.6-.4-2.3-.2-.1-.9-.7-1.7-1.5-2.2l-.3-.2-.2.3c-.4.6-.5 1.5-.4 2.2.1.5.3 1 .7 1.3H2.6c-.2 1.2.1 2.7 1 3.8 1.2 1.5 3.1 2.2 5.6 2.2 5.3 0 9.3-2.5 11.1-6.9.7 0 2.3 0 3.1-1.5l.1-.2-.3-.2c-.6-.4-2.1-.6-3.3-.4z" />
            </svg>
          )}

          {item.id === 'linux' && (
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4" width="18" height="16" rx="2" />
              <path d="M7.5 9.5L10.5 12l-3 2.5" />
              <path d="M12.5 14.5h4" />
            </svg>
          )}

          {item.id === 'git' && (
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="6" cy="6" r="2.2" />
              <circle cx="18" cy="8" r="2.2" />
              <circle cx="6" cy="18" r="2.2" />
              <path d="M6 8.2v7.6M8.2 6h5.3a2.5 2.5 0 0 1 2.5 2.5v0M8.2 18h4.3a3.5 3.5 0 0 0 3.5-3.5V10.2" />
            </svg>
          )}

          {item.id === 'zustand' && (
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true">
              <rect x="4" y="5" width="16" height="4" rx="1" />
              <rect x="4" y="10" width="16" height="4" rx="1" />
              <rect x="4" y="15" width="16" height="4" rx="1" />
            </svg>
          )}

          {item.id === 'mercadopago' && (
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="5.5" width="18" height="13" rx="2" />
              <path d="M3 10h18M7 14.5h4" />
            </svg>
          )}

          {item.id === 'sharp' && (
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="8.5" />
              <path d="M14.31 8l5.74 9.94M9.69 8h11.48M7.38 12l5.74-9.94M9.69 16L3.95 6.06M14.31 16H2.83M16.62 12l-5.74 9.94" />
            </svg>
          )}

          {item.id === 'vitest' && (
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M13 3L4 14h7l-1 7 9-11h-7l1-7Z" />
            </svg>
          )}

          {item.id === 'fastify' && (
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 5h12M6 12h9M6 5v14M17 12l4-2-4-2" />
            </svg>
          )}

          {item.id === 'drizzle' && (
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3.5c-3.5 4.3-6 7.5-6 10.6a6 6 0 0 0 12 0c0-3.1-2.5-6.3-6-10.6Z" />
              <path d="M9.5 14.5a2.5 2.5 0 0 0 2.5 2.5" />
            </svg>
          )}

          {item.id === 'minio' && (
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3L20 7.5V16.5L12 21L4 16.5V7.5L12 3Z" />
              <path d="M12 12l8-4.5M12 12v9M12 12L4 7.5" />
            </svg>
          )}

          {item.id === 'gemini' && (
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 2.5c1.2 5.4 4.1 8.3 9.5 9.5-5.4 1.2-8.3 4.1-9.5 9.5-1.2-5.4-4.1-8.3-9.5-9.5 5.4-1.2 8.3-4.1 9.5-9.5Z" />
            </svg>
          )}
        </button>

        <!-- Sharp tooltip revealed on hover / keyboard focus -->
        <span
          role="tooltip"
          class="pointer-events-none absolute -top-8 left-1/2 -translate-x-1/2 translate-y-1 whitespace-nowrap rounded-[2px] border border-[var(--border-strong)] bg-[var(--surface-solid)] px-2 py-0.5 font-mono text-[11px] font-medium text-[var(--text)] opacity-0 transition-all duration-150 group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:translate-y-0 group-focus-within:opacity-100"
        >
          {item.label}
        </span>
      </div>
    ))
  }
</div>
